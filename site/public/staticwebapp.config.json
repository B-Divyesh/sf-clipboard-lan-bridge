{
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "no-referrer",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
    "Content-Security-Policy": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
  },
  "responseOverrides": { "404": { "rewrite": "/404.html" } },
  "routes": [
    { "route": "/assets/*", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "route": "/sw.js", "headers": { "Cache-Control": "no-cache" } },
    { "route": "/*.sh", "headers": { "Content-Type": "text/plain; charset=utf-8", "Cache-Control": "no-cache" } },
    { "route": "/*.ps1", "headers": { "Content-Type": "text/plain; charset=utf-8", "Cache-Control": "no-cache" } }
  ]
}
