{
  "name": "clipboard-lan-bridge",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:site": "vite --config vite.site.config.ts",
    "tauri": "node scripts/tauri.mjs",
    "build:mobile": "esbuild src/mobile-companion.ts --bundle --format=esm --target=es2022 --minify --outfile=src-tauri/src/mobile.js",
    "build:app": "npm run build:mobile && vite build",
    "build:site": "vite build --config vite.site.config.ts",
    "build": "npm run build:app && npm run build:site",
    "pretest": "npm run build:mobile",
    "test": "vitest run src/domain.test.ts && node --test scripts/verify-release.test.mjs && playwright test && cargo test --manifest-path src-tauri/Cargo.toml",
    "test:ui": "playwright test",
    "precheck": "npm run build:mobile",
    "check": "tsc --noEmit && cargo check --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@tauri-apps/api": "^2.8.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.58.2",
    "@tauri-apps/cli": "^2.8.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
