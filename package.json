{
  "name": "clipboard-lan-bridge",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:site": "vite --config vite.site.config.ts",
    "tauri": "tauri",
    "build:app": "vite build",
    "build:site": "vite build --config vite.site.config.ts",
    "build": "npm run build:app && npm run build:site",
    "test": "vitest run src/domain.test.ts && playwright test && cargo test --manifest-path src-tauri/Cargo.toml",
    "test:ui": "playwright test",
    "check": "tsc --noEmit && cargo check --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "1.58.2",
    "@tauri-apps/cli": "^2.8.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
